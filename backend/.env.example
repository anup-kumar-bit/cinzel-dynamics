# Copy to .env and fill in real values. .env is gitignored.

# postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cinzel

# Any long random string — used to sign session JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# From your Cloudinary dashboard (cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:3000

# true in production — makes the session cookie HTTPS-only.
IS_PRODUCTION=false
